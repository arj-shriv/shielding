# Copy this file to secrets.toml (same folder) and fill in real values.
# secrets.toml is gitignored — never commit real secrets.
#
# On Streamlit Community Cloud, paste the same key/value pairs into
# the app's Settings -> Secrets panel instead of shipping a file.

EXPLORER_PASSWORD = "change-me"

# Optional — Tier 2 (GitHub collaborator) auto-unlock, used by app/pages/2_Model_Explorer.py
# if a collaborator sets this in their local .env / secrets.toml.
# COLLABORATOR_TOKEN = ""

# Required for the Model Explorer's write actions (upload PHITS, add a source
# spectrum, push a newly trained model) — every write opens a PR, never pushes
# to main directly. Without this set, those panels show up read-only/disabled.
#
# Use a FINE-GRAINED token scoped to only this repo, with only:
#   Contents: Read and write
#   Pull requests: Read and write
# (github.com/settings/tokens?type=beta) — not a classic all-repo token. Anyone
# holding EXPLORER_PASSWORD can use this token's identity to open PRs, so keep
# its scope minimal.
GITHUB_PAT = ""
GITHUB_REPO = "arj-shriv/shielding"
GITHUB_BASE_BRANCH = "main"
