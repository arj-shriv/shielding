# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.eggs/
*.egg

# Environments
.venv/
venv/
env/

# Testing
.pytest_cache/
.coverage
htmlcov/

# Generated run artifacts (keep structure, ignore contents)
runs/training/*/
runs/inference/*/
runs/evaluation/*/
runs/multilayer/*/
!runs/*/.gitkeep

# Generated reports (keep selected ones explicitly)
reports/figures/
reports/tables/
reports/pdf/
reports/exports/
!reports/**/.gitkeep

# Auto-generated inference outputs


# Jupyter
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db

# Large generated files at repo root (legacy location)
*.png
*.pdf
*.zip
predictions.zip
adj_ratio_comparison.png
dose_*.pdf
model_comparison_table.png

# Allow paper images, app assets, and root inference notebook
!images_for_paper/
!images_for_paper/**
!app/assets/
!app/assets/**
!inference_notebook.ipynb

# Re-exclude bytecode caches even under the negated paths above
images_for_paper/**/__pycache__/
app/assets/**/__pycache__/

# Generated test datasets inside model folders (large, reproducible)
models/**/testdata.npz
models/**/*_sample*.png

# Local config overrides
.env
*.local.yaml

# Streamlit secrets (EXPLORER_PASSWORD, COLLABORATOR_TOKEN, GITHUB_PAT) — never commit
.streamlit/secrets.toml

# Claude Code session transcripts — not project content
*.jsonl
